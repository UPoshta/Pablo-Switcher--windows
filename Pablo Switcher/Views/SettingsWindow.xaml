<Window x:Class="Pablo_Switcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pablo Switcher Settings"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid Margin="22,20,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Мова інтерфейсу -->
        <TextBlock x:Name="LblLanguage"
                   Grid.Row="0" Grid.Column="0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Мова інтерфейсу:"/>
        <ComboBox x:Name="ComboLanguage"
                  Grid.Row="0" Grid.Column="1"
                  Height="30"
                  VerticalContentAlignment="Center"
                  Padding="8,0"/>

        <!-- Гаряча клавіша -->
        <TextBlock x:Name="LblHotkey"
                   Grid.Row="2" Grid.Column="0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Гаряча клавіша:"/>
        <ComboBox x:Name="ComboHotkey"
                  Grid.Row="2" Grid.Column="1"
                  Height="30"
                  VerticalContentAlignment="Center"
                  Padding="8,0"/>

        <!-- Чекбокс автоперемикання -->
        <CheckBox x:Name="ChkAutoSwitch"
                  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                  VerticalContentAlignment="Center"
                  Content="Автоматично перемикати розкладку"/>

        <!-- Підказка -->
        <TextBlock x:Name="LblHint"
                   Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   FontSize="12"
                   LineHeight="17"
                   Text="Підказка..."/>

        <!-- Кнопка Зберегти -->
        <Button x:Name="BtnSave"
                Grid.Row="8" Grid.Column="1"
                HorizontalAlignment="Right"
                MinWidth="115"
                Height="32"
                Padding="16,0"
                IsDefault="True"
                Click="OnSaveClicked"
                Content="Зберегти"/>
    </Grid>
</Window>
